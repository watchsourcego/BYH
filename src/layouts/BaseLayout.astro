---
import "../styles/global.css";
import { brand } from "../../brand.config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = brand.name,
  description = brand.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style
      define:vars={{
        colorPrimary: brand.colors.primary,
        colorAccent: brand.colors.accent,
        colorBackground: brand.colors.background,
        colorText: brand.colors.text,
        colorTextMuted: brand.colors.textMuted,
        colorOnPrimary: brand.colors.onPrimary,
        fontDisplay: brand.fonts.display,
        fontBody: brand.fonts.body,
      }}
    >
      :root {
        --color-primary: var(--colorPrimary);
        --color-accent: var(--colorAccent);
        --color-background: var(--colorBackground);
        --color-text: var(--colorText);
        --color-text-muted: var(--colorTextMuted);
        --color-on-primary: var(--colorOnPrimary);
        --font-display: var(--fontDisplay);
        --font-body: var(--fontBody);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
