---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { brand } from "../../brand.config";
import SiteHeader from "../components/SiteHeader.astro";
import SiteBottomNav from "../components/SiteBottomNav.astro";
import SiteLocaleCurrencyFab from "../components/SiteLocaleCurrencyFab.astro";
import { resolveLocale } from "@/i18n/ui";
import type { Locale } from "@/i18n/config";
import { hreflangAlternates, hreflangDefault } from "@/i18n/paths";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Show grain texture overlay */
  grain?: boolean;
}

const {
  title = brand.name,
  description = brand.seo.description,
  ogImage = brand.seo.ogImage,
  grain = true,
} = Astro.props;

const locale = resolveLocale(Astro.currentLocale) as Locale;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternates = hreflangAlternates(Astro.url.pathname, Astro.site!);
const xDefaultHref = hreflangDefault(Astro.url.pathname, Astro.site!);
const pageTitle = title === brand.name ? brand.name : `${title} · ${brand.name}`;
const ogImageURL = new URL(ogImage, Astro.site);
const logoSolidURL = new URL(brand.logos.solid, Astro.site);
const htmlDir = locale === "ar" ? "rtl" : "ltr";
const ogLocale =
  locale === "en"
    ? "en_US"
    : locale === "es"
      ? "es_ES"
      : locale === "pt"
        ? "pt_BR"
        : locale === "fr"
          ? "fr_FR"
          : locale === "de"
            ? "de_DE"
            : locale === "ru"
              ? "ru_RU"
              : locale === "ar"
                ? "ar_SA"
                : "id_ID";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${brand.siteUrl}/#organization`,
  name: brand.legalName,
  alternateName: brand.name,
  url: brand.siteUrl,
  logo: {
    "@type": "ImageObject",
    url: logoSolidURL.href,
    caption: `${brand.name} logo`,
  },
  image: logoSolidURL.href,
  email: brand.supportEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: brand.address.line1,
    addressLocality: brand.address.city,
    addressRegion: brand.address.region,
    addressCountry: brand.address.country,
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${brand.siteUrl}/#website`,
  name: brand.name,
  url: brand.siteUrl,
  description: brand.seo.description,
  publisher: { "@id": `${brand.siteUrl}/#organization` },
};
---

<!doctype html>
<html lang={locale} dir={htmlDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <title>{pageTitle}</title>

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content={`${brand.name} logo`} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${brand.name} logo`} />

    <link rel="icon" type="image/webp" href={brand.logos.solid} />
    <link rel="apple-touch-icon" href={brand.logos.solid} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <style
      define:vars={{
        colorPrimary: brand.colors.primary,
        colorAccent: brand.colors.accent,
        colorBackground: brand.colors.background,
        colorText: brand.colors.text,
        colorTextMuted: brand.colors.textMuted,
        colorOnPrimary: brand.colors.onPrimary,
        fontDisplay: brand.fonts.display,
        fontBody: brand.fonts.body,
      }}
    >
      :root {
        --color-primary: var(--colorPrimary);
        --color-accent: var(--colorAccent);
        --color-background: var(--colorBackground);
        --color-text: var(--colorText);
        --color-text-muted: var(--colorTextMuted);
        --color-on-primary: var(--colorOnPrimary);
        --color-accent-secondary: #00d4ff;
        --font-display: var(--fontDisplay);
        --font-body: var(--fontBody);
      }
    </style>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[{ grain }]}>
    <SiteHeader />
    <slot />
    <SiteBottomNav />
    <SiteLocaleCurrencyFab />
  </body>
</html>
