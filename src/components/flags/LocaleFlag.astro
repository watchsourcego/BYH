---
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale | string;
  class?: string;
}

const { locale, class: className = "fab-flag" } = Astro.props;
---

{locale === "en" && (
  <svg class={className} viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="60" height="30" fill="#B22234" />
    <path fill="#FFF" d="M0 2.307h60v2.307H0zm0 4.615h60v2.307H0zm0 4.615h60v2.307H0zm0 4.615h60v2.307H0zm0 4.615h60v2.307H0zm0 4.615h60v2.307H0z" />
    <rect width="24.38" height="16.154" fill="#3C3B6E" />
    <g fill="#FFF">
      <circle r="0.55" cx="2.9" cy="2.3" /><circle r="0.55" cx="8" cy="2.3" /><circle r="0.55" cx="13.1" cy="2.3" /><circle r="0.55" cx="18.2" cy="2.3" />
      <circle r="0.55" cx="5.45" cy="4.85" /><circle r="0.55" cx="11.75" cy="4.85" /><circle r="0.55" cx="16.85" cy="4.85" />
      <circle r="0.55" cx="2.9" cy="7.45" /><circle r="0.55" cx="8" cy="7.45" /><circle r="0.55" cx="13.1" cy="7.45" />
    </g>
  </svg>
)}
{locale === "es" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="5" fill="#AA151B" /><rect y="5" width="30" height="10" fill="#F1BF00" /><rect y="15" width="30" height="5" fill="#AA151B" />
  </svg>
)}
{locale === "pt" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="20" fill="#009B3A" /><polygon points="15,1.5 28.5,10 15,18.5 1.5,10" fill="#FEDF00" /><circle cx="15" cy="10" r="4.2" fill="#002776" />
  </svg>
)}
{locale === "ru" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="6.67" fill="#FFFFFF" /><rect y="6.67" width="30" height="6.66" fill="#0039A6" /><rect y="13.33" width="30" height="6.67" fill="#D52B1E" />
  </svg>
)}
{locale === "fr" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="10" height="20" fill="#002395" /><rect x="10" width="10" height="20" fill="#FFFFFF" /><rect x="20" width="10" height="20" fill="#ED2939" />
  </svg>
)}
{locale === "de" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="6.67" fill="#000" /><rect y="6.67" width="30" height="6.66" fill="#DD0000" /><rect y="13.33" width="30" height="6.67" fill="#FFCE00" />
  </svg>
)}
{locale === "ar" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="20" fill="#006C35" />
    <path fill="#FFF" d="M8.5 14.2c2.8-3.1 5.6-6.2 8.4-9.3.4-.4 1-.1 1 .5v1.2c-2.5 2.8-5 5.6-7.5 8.4-.3.3-.8.3-1.1 0-.3-.3-.3-.6-.1-.9.7-.8 1.4-1.6 2.1-2.4.5-.6 1.5-.3 1.5.5v.6c-.6.7-1.2 1.4-1.8 2.1-.2.3-.6.3-.8 0z" />
    <rect x="17.5" y="12.8" width="7.5" height="1.1" rx="0.4" fill="#FFF" />
  </svg>
)}
{locale === "id" && (
  <svg class={className} viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="30" height="10" fill="#FF0000" /><rect y="10" width="30" height="10" fill="#FFFFFF" />
  </svg>
)}
