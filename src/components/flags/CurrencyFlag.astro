---
import {
  CURRENCY_FLAG_REGION,
  type DisplayCurrencyCode,
} from "@/lib/display-currency";

interface Props {
  code: DisplayCurrencyCode | string;
  class?: string;
}

const { code, class: className = "fab-flag" } = Astro.props;
const region = (CURRENCY_FLAG_REGION[code as DisplayCurrencyCode] ?? "UN").toLowerCase();
const src = `https://flagcdn.com/24x18/${region}.png`;
---

<img
  class={className}
  src={src}
  alt=""
  width="24"
  height="18"
  decoding="async"
  loading="lazy"
  aria-hidden="true"
/>
