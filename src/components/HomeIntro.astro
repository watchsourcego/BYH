---
import { brand } from "../../brand.config";
import WhatsAppButton from "./WhatsAppButton.astro";
import BrandLogo from "./BrandLogo.astro";
import { homeWhatsAppMessage } from "../lib/whatsapp";

interface Props {
  /** Use "h1" on the primary intro (mobile hero). Desktop duplicate uses "p" to keep one h1 per page. */
  headingTag?: "h1" | "p";
  headingId?: string;
}

const { headingTag = "h1", headingId = "home-heading" } = Astro.props;
const HeadingTag = headingTag;
---

<div class="home-intro">
  <HeadingTag id={headingId} class="home-intro__brand">
    <BrandLogo variant="light" class="home-intro__logo" width={120} height={44} />
  </HeadingTag>
  <p class="home-intro__text">{brand.seo.homeIntro}</p>
  <p class="home-intro__links">
    <a href="/shop">Shop watches</a>
    <span aria-hidden="true"> · </span>
    <a href="/about">About us</a>
  </p>
  <WhatsAppButton
    message={homeWhatsAppMessage()}
    context="homepage inquiry"
    class="home-intro__whatsapp"
  />
</div>

<style>
  .home-intro {
    text-align: center;
    padding: 0.75rem clamp(1rem, 4vw, 2rem);
  }

  .home-intro__brand {
    display: flex;
    justify-content: center;
    margin: 0 0 0.5rem;
    line-height: 0;
  }

  .home-intro__logo {
    display: block;
    width: clamp(6rem, 18vw, 8.5rem);
    height: auto;
    aspect-ratio: 120 / 44;
    object-fit: contain;
    margin-inline: auto;
    filter: drop-shadow(0 2px 8px rgb(0 0 0 / 0.45));
  }

  .home-intro__text {
    margin: 0 0 0.75rem;
    font-size: clamp(0.75rem, 2.8vw, 0.9375rem);
    line-height: 1.55;
    color: #fff;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.4);
  }

  .home-intro__links {
    margin: 0;
    font-size: clamp(0.625rem, 2.2vw, 0.8125rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.55),
      0 2px 8px rgb(0 0 0 / 0.4);
  }

  .home-intro__links a {
    color: #fff;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .home-intro__links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .home-intro :global(.home-intro__whatsapp) {
    margin-top: 1rem;
    text-shadow: none;
    box-shadow:
      0 4px 16px rgb(37 211 102 / 0.4),
      0 2px 12px rgb(0 0 0 / 0.35);
  }

  @media (max-width: 768px) {
    .home-intro {
      padding: 0.5rem 1rem;
    }

    .home-intro__brand {
      margin-bottom: 0.75rem;
    }

    .home-intro__logo {
      width: 7rem;
      filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.65));
    }

    .home-intro__text {
      margin-bottom: 0.875rem;
      font-size: 0.8125rem;
      line-height: 1.6;
      text-shadow:
        0 2px 4px rgb(0 0 0 / 0.8),
        0 4px 14px rgb(0 0 0 / 0.7);
    }

    .home-intro__links {
      font-size: 0.6875rem;
      text-shadow:
        0 2px 4px rgb(0 0 0 / 0.85),
        0 4px 12px rgb(0 0 0 / 0.7);
    }
  }
</style>
