---
import {
  DISPLAY_CURRENCIES,
  CURRENCY_FLAG_REGION,
  inferDisplayCurrencyFromLocale,
  type DisplayCurrencyCode,
} from "@/lib/display-currency";
import { localeLabels, locales, type Locale } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
import { switchLocalePath } from "@/i18n/paths";
import LocaleFlag from "./flags/LocaleFlag.astro";
import CurrencyFlag from "./flags/CurrencyFlag.astro";

const locale = Astro.currentLocale as Locale;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const localeOptions = locales.map((code) => ({
  code,
  label: localeLabels[code],
  href: switchLocalePath(currentPath, code),
}));

const defaultCurrency = inferDisplayCurrencyFromLocale(locale);
const approxLabel = t("DisplayCurrency.approx");

function currencyFlagSrc(code: DisplayCurrencyCode): string {
  const region = (CURRENCY_FLAG_REGION[code] ?? "UN").toLowerCase();
  return `https://flagcdn.com/24x18/${region}.png`;
}
---

<div
  class="locale-currency-fab"
  data-locale-currency-fab
  data-current-locale={locale}
  data-default-currency={defaultCurrency}
  data-approx-label={approxLabel}
>
  <div class="locale-currency-fab__group">
    <div class="locale-currency-fab__switcher-wrap" data-locale-switcher>
    <div class="locale-currency-fab__switcher" data-locale-switcher-inner>
      <div class="locale-currency-fab__popover" data-locale-popover data-open="false">
        <ul class="locale-currency-fab__list" role="listbox" aria-label={t("LocaleSwitcher.label")}>
          {localeOptions
            .filter((item) => item.code !== locale)
            .map((item) => (
              <li>
                <a class="locale-currency-fab__pill" href={item.href} role="option" data-locale-link>
                  <LocaleFlag locale={item.code} />
                  <span aria-hidden="true">{item.code.toUpperCase()}</span>
                  <span class="sr-only">{item.label}</span>
                </a>
              </li>
            ))}
        </ul>
      </div>
      <button
        type="button"
        class="locale-currency-fab__pill locale-currency-fab__trigger"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-label={t("LocaleSwitcher.label")}
        data-locale-trigger
      >
        <svg class="locale-currency-fab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m5 8 6 6" /><path d="m4 14 6-6 2-3" /><path d="M2 5h12" /><path d="M7 2h1" /><path d="m22 22-5-10-5 10" /><path d="M14 18h6" />
        </svg>
        <LocaleFlag locale={locale} />
        <span aria-hidden="true">{locale.toUpperCase()}</span>
        <span class="sr-only">{localeLabels[locale]}</span>
      </button>
    </div>
    </div>

    <div class="locale-currency-fab__switcher-wrap" data-currency-switcher>
    <div class="locale-currency-fab__switcher" data-currency-switcher-inner>
      <div class="locale-currency-fab__popover locale-currency-fab__popover--currency" data-currency-popover data-open="false">
        <ul class="locale-currency-fab__list" role="listbox" aria-label={t("DisplayCurrency.label")}>
          {DISPLAY_CURRENCIES.map((item) => (
            <li>
              <button
                type="button"
                class="locale-currency-fab__pill locale-currency-fab__pill--option"
                role="option"
                data-currency-option={item.code}
              >
                <CurrencyFlag code={item.code} />
                <span aria-hidden="true">{item.code}</span>
                <span class="sr-only">{item.label}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <button
        type="button"
        class="locale-currency-fab__pill locale-currency-fab__trigger"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-label={t("DisplayCurrency.label")}
        data-currency-trigger
      >
        <svg class="locale-currency-fab__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="8" cy="8" r="6" /><path d="M18.09 10.37A6 6 0 1 1 10.34 18" /><path d="M7 6h1v4" /><path d="m16.71 13.88.7.71-2.82 2.82" />
        </svg>
        <img
          class="fab-flag"
          data-current-currency-flag
          src={currencyFlagSrc(defaultCurrency)}
          alt=""
          width="24"
          height="18"
          decoding="async"
          aria-hidden="true"
        />
        <span aria-hidden="true" data-current-currency-code>{defaultCurrency}</span>
        <span class="sr-only">{t("DisplayCurrency.label")}</span>
      </button>
    </div>
    </div>
  </div>
</div>

<script>
  import { CURRENCY_FLAG_REGION } from "@/lib/display-currency";
  import { initAllLocaleCurrencyFabs } from "@/lib/locale-currency-fab.client";

  initAllLocaleCurrencyFabs(CURRENCY_FLAG_REGION);
</script>

<style>
  .locale-currency-fab {
    position: fixed;
    bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
    left: clamp(1rem, 3vw, 1.5rem);
    z-index: 110;
    pointer-events: none;
  }

  .locale-currency-fab__group {
    display: flex;
    align-items: flex-end;
    gap: 0.375rem;
  }

  .locale-currency-fab__switcher-wrap {
    pointer-events: auto;
  }

  .locale-currency-fab__switcher {
    position: relative;
    display: inline-block;
  }

  .locale-currency-fab__popover {
    position: absolute;
    bottom: calc(100% - 0.625rem);
    left: 0;
    z-index: 2;
    min-width: 100%;
    margin-bottom: 0;
    /* Overlap trigger slightly so hover path has no dead zone */
    padding-bottom: 0.625rem;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  /* Invisible bridge between menu and trigger button */
  .locale-currency-fab__popover::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0.625rem;
  }

  .locale-currency-fab__popover[data-open="true"] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    z-index: 120;
  }

  .locale-currency-fab__popover--currency .locale-currency-fab__list {
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .locale-currency-fab__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .locale-currency-fab__pill {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.375rem;
    min-width: 5.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      0 4px 24px rgb(0 0 0 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.22);
    transition:
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .locale-currency-fab__pill:hover,
  .locale-currency-fab__pill:focus-visible,
  .locale-currency-fab__switcher:hover > .locale-currency-fab__trigger {
    background: rgb(20 20 40 / 0.92);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.2);
    outline: none;
  }

  .locale-currency-fab__pill.is-selected {
    background: rgb(20 20 40 / 0.92);
    box-shadow:
      0 4px 16px rgb(0 0 0 / 0.2),
      inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .locale-currency-fab__pill--option {
    width: 100%;
    cursor: pointer;
    touch-action: manipulation;
    position: relative;
    z-index: 1;
  }

  .locale-currency-fab__pill--option :global(img.fab-flag) {
    pointer-events: none;
  }

  .locale-currency-fab__trigger {
    cursor: pointer;
  }

  .locale-currency-fab__icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    opacity: 0.72;
  }

  :global(.fab-flag) {
    width: 1.26rem;
    height: 0.9rem;
    flex-shrink: 0;
    border-radius: 1px;
    border: 1px solid rgb(255 255 255 / 0.25);
    object-fit: cover;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.2);
  }

  :global(svg.fab-flag) {
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .locale-currency-fab {
      bottom: calc(var(--site-bottom-nav-offset) + 0.5rem);
    }
  }
</style>
