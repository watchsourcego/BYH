---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resolveLocale, useTranslations } from "@/i18n/ui";
import type { Locale } from "@/i18n/config";

const locale = resolveLocale(Astro.currentLocale) as Locale;
const t = useTranslations(locale);

const factoryImages = [
  { src: "/Factory-environment/BYH-factory01.webp", alt: t("About.factoryAlt1") },
  { src: "/Factory-environment/BYH-factory02.webp", alt: t("About.factoryAlt2") },
  { src: "/Factory-environment/BYH-factory03.webp", alt: t("About.factoryAlt3") },
  { src: "/Factory-environment/BYH-factory04.webp", alt: t("About.factoryAlt4") },
  { src: "/Factory-environment/BYH-factory05.webp", alt: t("About.factoryAlt5") },
];
---

<BaseLayout title={t("About.title")} description={t("About.metaDescription")}>
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>{t("About.title")}</h1>
      <p>{t("About.intro1")}</p>
      <p>{t("About.intro2")}</p>

      <h2>{t("About.strengthsTitle")}</h2>
      <ul>
        <li><strong>{t("About.strength1Title")}</strong> {t("About.strength1")}</li>
        <li><strong>{t("About.strength2Title")}</strong> {t("About.strength2")}</li>
        <li><strong>{t("About.strength3Title")}</strong> {t("About.strength3")}</li>
        <li><strong>{t("About.strength4Title")}</strong> {t("About.strength4")}</li>
      </ul>

      <p>{t("About.closing")}</p>
    </div>

    <section class="factory-gallery" aria-label={t("About.factoryGallery")}>
      <ul class="factory-gallery__grid">
        {factoryImages.map((image) => (
          <li class="factory-gallery__item">
            <img
              src={image.src}
              alt={image.alt}
              width="640"
              height="640"
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .factory-gallery {
    width: min(72rem, 100%);
    margin: clamp(1.5rem, 4vw, 2.5rem) auto 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.22);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .factory-gallery__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.2vw, 0.875rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .factory-gallery__item {
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }

  .factory-gallery__item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .factory-gallery__item:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    .factory-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .factory-gallery {
      padding: 0.875rem;
    }
  }
</style>
