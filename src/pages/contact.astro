---
import BaseLayout from "../layouts/BaseLayout.astro";
import { brand } from "../../brand.config";
---

<BaseLayout title="Contact" description={`Contact ${brand.name}`}>
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>Contact</h1>
      <p>
        Questions about orders, wholesale, or custom designs? We'd love to hear
        from you.
      </p>

      <form class="contact-form" id="contact-form" novalidate>
        <div class="contact-form__field">
          <label for="contact-name">Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            maxlength="120"
          />
        </div>

        <div class="contact-form__field">
          <label for="contact-email">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
          />
        </div>

        <div class="contact-form__field">
          <label for="contact-subject">Subject</label>
          <input
            id="contact-subject"
            name="subject"
            type="text"
            maxlength="200"
            placeholder="Order inquiry, wholesale, custom design..."
          />
        </div>

        <div class="contact-form__field">
          <label for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            required
            maxlength="5000"></textarea>
        </div>

        <div class="contact-form__honeypot" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button class="contact-form__submit" type="submit">
          Send message
        </button>

        <p class="contact-form__status" id="contact-status" role="status"></p>
      </form>

      <div class="contact-location">
        <div class="contact-location__map">
          <iframe
            title="BYH factory location map"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://maps.google.com/maps?q=${encodeURIComponent(brand.address.full)}&hl=en&z=16&output=embed`}
          ></iframe>
        </div>
        <div class="contact-location__info">
          <p>
            <strong>Address:</strong>
            <span>
              {brand.address.line1}<br />
              {brand.address.city}, {brand.address.region}, {brand.address.country}
            </span>
          </p>
          <p>
            <strong>Email:</strong>{" "}
            <a href={`mailto:${brand.supportEmail}`}>{brand.supportEmail}</a>
          </p>
          <p>
            <strong>WhatsApp:</strong>{" "}
            <a href={brand.whatsappUrl} target="_blank" rel="noopener noreferrer">
              {brand.whatsapp}
            </a>
          </p>
          <p>
            <strong>Hours:</strong> Mon–Fri, 9:00–18:00 (GMT+8)
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form || !status) return;

    const submitButton = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement | null;

    status.textContent = "";
    status.dataset.state = "";
    submitButton?.setAttribute("disabled", "true");

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get("name") ?? "").trim(),
      email: String(formData.get("email") ?? "").trim(),
      subject: String(formData.get("subject") ?? "").trim(),
      message: String(formData.get("message") ?? "").trim(),
      website: String(formData.get("website") ?? "").trim(),
    };

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });

      const contentType = response.headers.get("content-type") ?? "";

      if (!contentType.includes("application/json")) {
        status.textContent =
          response.status === 404
            ? "Contact form API is not deployed yet. Please redeploy the site or email us directly."
            : "Contact service unavailable. Please email us directly.";
        status.dataset.state = "error";
        return;
      }

      const result = (await response.json()) as { ok?: boolean; error?: string };

      if (!response.ok || !result.ok) {
        status.textContent =
          result.error ?? "Something went wrong. Please try again.";
        status.dataset.state = "error";
        return;
      }

      form.reset();
      status.textContent = "Thanks — your message has been sent.";
      status.dataset.state = "success";
    } catch {
      status.textContent =
        "Network error. If you're testing locally, deploy to Cloudflare Pages first.";
      status.dataset.state = "error";
    } finally {
      submitButton?.removeAttribute("disabled");
    }
  });
</script>

<style>
  .page-shell__inner {
    width: min(56rem, 100%);
  }

  .contact-location {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1rem, 2.5vw, 1.5rem);
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .contact-location__map {
    overflow: hidden;
    min-height: 14rem;
    border-radius: 1rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }

  .contact-location__map iframe {
    width: 100%;
    height: 100%;
    min-height: 14rem;
    border: 0;
    display: block;
  }

  .contact-location__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.875rem;
  }

  .contact-location__info p {
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .contact-location__info strong {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .contact-location__info span {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .contact-location {
      grid-template-columns: 1fr;
    }

    .contact-location__map iframe {
      min-height: 12rem;
    }
  }
</style>
