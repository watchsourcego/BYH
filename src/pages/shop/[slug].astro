---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductDetailView from "../../components/ProductDetailView.astro";
import {
  getAdjacentProducts,
  getProductDetail,
} from "../../data/productDetails";
import { productSlugStaticPaths } from "@/lib/product-slug-paths";

export function getStaticPaths() {
  return productSlugStaticPaths();
}

const { slug } = Astro.params;
const product = getProductDetail(slug!);
const { prev: prevProduct, next: nextProduct } = getAdjacentProducts(slug!);

if (!product) {
  return Astro.redirect("/404");
}
---

<BaseLayout
  title={product.title}
  description={product.description}
  grain={true}
>
  <main>
    <ProductDetailView
      product={product}
      prevProduct={prevProduct}
      nextProduct={nextProduct}
    />
  </main>
</BaseLayout>
