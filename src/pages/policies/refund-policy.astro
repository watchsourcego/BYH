---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Refund Policy">
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>Refund Policy</h1>
      <p><em>Last updated: September 2026</em></p>
      <p>
        We accept returns within 30 days of delivery for unused items in original
        packaging. To initiate a return, contact us with your order number.
      </p>
      <p>
        Refunds are processed to the original payment method within 5–10 business
        days after we receive and inspect the returned item. Shipping costs are
        non-refundable unless the return is due to our error.
      </p>
    </div>
  </div>
</BaseLayout>
