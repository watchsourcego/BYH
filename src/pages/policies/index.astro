---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPolicyNav } from "../../data/navigation";
import { localeHref } from "@/i18n/paths";
import { resolveLocale, useTranslations } from "@/i18n/ui";
import type { Locale } from "@/i18n/config";

const locale = resolveLocale(Astro.currentLocale) as Locale;
const t = useTranslations(locale);
const href = (path: string) => localeHref(locale, path);
const policyNav = getPolicyNav(t, href);
---

<BaseLayout title={t("Policies.title")} description={t("Policies.metaDescription")}>
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>{t("Policies.title")}</h1>
      <p>{t("Policies.intro")}</p>
      <ul class="policy-links">
        {policyNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
