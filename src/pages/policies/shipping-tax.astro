---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Shipping & Tax">
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>Shipping &amp; Tax</h1>
      <p><em>Last updated: September 2026</em></p>
      <p>
        Orders ship within 2–5 business days. Standard delivery typically takes
        7–14 business days depending on destination. Express options are
        available at checkout.
      </p>
      <p>
        Applicable sales tax or VAT is calculated at checkout based on your
        shipping address. International orders may be subject to customs duties
        and import taxes, which are the responsibility of the recipient.
      </p>
    </div>
  </div>
</BaseLayout>
