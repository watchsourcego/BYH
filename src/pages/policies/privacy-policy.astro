---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy">
  <div class="page-shell">
    <div class="page-shell__inner">
      <h1>Privacy Policy</h1>
      <p><em>Last updated: September 2026</em></p>
      <p>
        We collect information you provide when placing an order, creating an
        account, or contacting us — including name, email, shipping address, and
        payment details processed securely by our payment provider.
      </p>
      <p>
        We use this data to fulfill orders, communicate with you, and improve our
        services. We do not sell your personal information to third parties.
      </p>
    </div>
  </div>
</BaseLayout>
